# ==============================================================================
# VANGUARD DEFENSE & SECURITY SOLUTIONS - ENVIRONMENT CONFIGURATION
# Framework: Next.js (App Router)
# ==============================================================================

# Public API Base Path for Axios / Client requests
# Defaults to '/api' so requests are reverse-proxied by Next.js to the backend
NEXT_PUBLIC_API_BASE_URL=/api

# Spring Boot Backend Service URL
# Used by Next.js rewrites in next.config.mjs to forward /api and /uploads traffic
BACKEND_URL=http://localhost:8095

# Local Next.js Server Port (Default is 5174 to avoid conflicts with other local dev servers)
PORT=5174

# Application Branding & Metadata
NEXT_PUBLIC_APP_NAME="Vanguard Defense & Security Solutions"
NEXT_PUBLIC_COMPANY_NAME="ABC Security Services Inc."
NEXT_PUBLIC_COMPANY_TAGLINE="Professional Security Services You Can Trust"
NEXT_PUBLIC_PHONE_PRIMARY="+1 (800) 826-4827"
NEXT_PUBLIC_PHONE_EMERGENCY="+1 (800) 911-7328"
NEXT_PUBLIC_EMAIL="dispatch@securityservices.com"
NEXT_PUBLIC_LICENSE="Licensed & Bonded Private Security Contractor #PSC-84920-A"
